---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { site } from "../../data/site.js";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={`Blog | ${site.name}`} description="Notes on tooling, workflows and engineering.">
  <main class="page">
    <PageHeader path="BLOG" cmd="ls -t posts/" title="Blog" sub="Notes on tooling, workflows and engineering." />
    <div class="btns reveal" style="--i:3"><a class="btn" href="/rss.xml">RSS feed</a></div>
    <section class="card reveal" style="--i:4">
      <span class="label l">ALL POSTS</span>
      <table class="posts">
        <thead><tr><th>DATE</th><th>READ</th><th>POST</th></tr></thead>
        <tbody>
          {
            posts.map((p, i) => (
              <tr>
                <td>{fmt(p.data.date)}{i === 0 && <div class="kicker">■ LATEST</div>}</td>
                <td>{p.data.mins} min</td>
                <td>
                  <h2><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
                  <p>{p.data.description}</p>
                  {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </main>
</Layout>
