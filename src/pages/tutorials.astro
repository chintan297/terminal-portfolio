---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site, series } from "../data/site.js";
const first = series[0].items[0];
---

<Layout title={`Tutorials | ${site.name}`}>
  <main class="page">
    <PageHeader
      path="TUTORIALS"
      cmd="tutorials --list"
      title="Tutorials"
      sub="In-depth guides with worked examples."
    />
    <h2 class="level reveal" style="--i:4">SERIES LOG</h2>
    <p class="reveal" style="--i:5">
      start here: {first.id}
      {first.title}, {first.mins} min
    </p>
    {
      series.map((s, si) => (
        <>
          <h2 class="level">
            {String(si + 1).padStart(2, "0")} {s.level}
          </h2>
          <div class="grid2">
            {s.items.map((t, i) => (
              <article class="tcard reveal" style={`--i:${i + 6}`}>
                <div class="kicker">TUTORIAL/{t.id}</div>
                <h3>{t.title}</h3>
                <p>{t.desc}</p>
                <span class="tag">{t.mins} MIN</span>
                {t.tags.map((g) => (
                  <span class="tag">{g}</span>
                ))}
                <div>
                  <a href={t.href}>Read tutorial →</a>
                </div>
              </article>
            ))}
          </div>
        </>
      ))
    }
  </main>
</Layout>
