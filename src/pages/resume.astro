---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site, about, resumeData as r } from "../data/site.js";
---

<Layout title={`Resume | ${site.name}`}>
  <main class="page">
    <PageHeader
      path="RESUME"
      cmd="cat resume.md"
      title="Resume & Experience"
      sub="Full professional background and work history. Download as PDF or plain text."
    />
    <div class="resume-layout">
      <aside class="resume-side">
        <section class="card reveal" style="--i:4">
          <span class="label l">USER</span><strong>{site.name}</strong>
          <div class="prompt">{about.title}</div>
        </section>
        <section class="card reveal" style="--i:5">
          <span class="label l">DOWNLOADS</span>
          <div class="btns" style="margin:0">
            <button class="btn primary" onclick="print()">PDF</button>
            <a class="btn" href="#" style="min-width:0">TXT</a>
          </div>
        </section>
        <section class="card reveal" style="--i:6">
          <span class="label l">CONTACT</span>
          {r.contact.map((c) => <div>{c.href ? <a href={c.href} rel="noopener">{c.label}</a> : c.label}</div>)}
        </section>
        <section class="card reveal" style="--i:7">
          <span class="label l">FOCUS</span>
          {r.focus.map((f) => <span class="tag">{f}</span>)}
        </section>
        {r.languages.length > 0 && <section class="card reveal" style="--i:8">
          <span class="label l">LANGUAGES</span>
          {
            r.languages.map((l) => (
              <div class="gauge">
                <span class="prompt">{l.code}</span>
                <span>{l.name} · {l.level}</span>
              </div>
            ))
          }
        </section>}
      </aside>
    <section class="card resume-md reveal" style="--i:9">
      <span class="label l">RESUME.MD</span>
      <h2 class="name">{site.name}</h2>
      <p class="meta contact-line">{site.location} | <a href={`mailto:${site.email}`}>{site.email}</a> | <a href="https://www.linkedin.com/in/chintan-akbari/" rel="noopener">LinkedIn</a></p>
      <h3>Summary</h3>
      <p class="entry-text">{r.summary}</p>
      <h3>Work Experience</h3>
      {
        r.work.map((w) => (
          <article class="entry">
            <div class="entry-head">
              <strong class="entry-title">{w.role}</strong>
              <span class="entry-when">{w.when}</span>
            </div>
            <div class="entry-org">{w.org}</div>
            <ul class="entry-points">
              {w.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
      <h3>Education</h3>
      {
        r.education.map((e) => (
          <article class="entry">
            <div class="entry-head">
              <strong class="entry-title">{e.degree}</strong>
              {e.when && <span class="entry-when">{e.when}</span>}
            </div>
            <div class="entry-org">{e.org}</div>
          </article>
        ))
      }
      <h3>Skills</h3>
      <dl class="skill-rows">
        {
          Object.entries(r.skills).map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v.join(", ")}</dd>
            </>
          ))
        }
      </dl>
      <h3>Interests</h3>
      <p class="entry-text">{r.interests.join(", ")}</p>
    </section>
    </div>
  </main>
</Layout>
