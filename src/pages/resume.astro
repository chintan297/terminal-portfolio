---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site, about, resumeData as r } from "../data/site.js";
---

<Layout title={`Resume | ${site.name}`}>
  <main class="page">
    <PageHeader
      path="RESUME"
      cmd="cat resume.md"
      title="Resume & Experience"
      sub="Full professional background and work history. Download as PDF or plain text."
    />
    <div class="resume-layout">
      <aside class="resume-side">
        <section class="card reveal" style="--i:4">
          <span class="label l">USER</span><strong>{site.name}</strong>
          <div class="prompt">{about.title}</div>
        </section>
        <section class="card reveal" style="--i:5">
          <span class="label l">DOWNLOADS</span>
          <div class="btns" style="margin:0">
            <button class="btn primary" onclick="print()">PDF</button>
            <a class="btn" href="#" style="min-width:0">TXT</a>
          </div>
        </section>
        <section class="card reveal" style="--i:6">
          <span class="label l">CONTACT</span>
          {r.contact.map((c) => <div>{c}</div>)}
        </section>
        <section class="card reveal" style="--i:7">
          <span class="label l">FOCUS</span>
          {r.focus.map((f) => <span class="tag">{f}</span>)}
        </section>
        <section class="card reveal" style="--i:8">
          <span class="label l">LANGUAGES</span>
          {
            r.languages.map((l) => (
              <div class="gauge">
                <span class="prompt">{l.code}</span>
                <span>{l.name} · {l.level}</span>
              </div>
            ))
          }
        </section>
      </aside>
    <section class="card resume-md reveal" style="--i:9">
      <span class="label l">RESUME.MD</span>
      <h2 class="name">{site.name}</h2>
      <p class="meta contact-line">{site.location} | {site.email}</p>
      <h3>Summary</h3><p>{r.summary}</p>
      <h3>Work Experience</h3>
      {
        r.work.map((w) => (
          <div>
            <>
              <strong>{w.role}</strong>
              <div class="meta">
                {w.org} · {w.when}
              </div>
              <ul>
                {w.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </>
          </div>
        ))
      }
      <h3>Education</h3>
      {
        r.education.map((e) => (
          <div>
            <>
              <strong>{e.degree}</strong>
              <div class="meta">
                {e.org} · {e.when}
              </div>
            </>
          </div>
        ))
      }
      <h3>Skills</h3>
      {
        Object.entries(r.skills).map(([k, v]) => (
          <p>
            <strong>{k}:</strong> {v.join(", ")}
          </p>
        ))
      }
      <h3>Interests</h3><p>{r.interests.join(", ")}</p>
    </section>
    </div>
  </main>
</Layout>
