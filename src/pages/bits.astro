---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site, bits } from "../data/site.js";
---

<Layout title={`Bits | ${site.name}`}>
  <main class="page">
    <PageHeader
      path="BITS"
      cmd="bits --recent"
      title="Bits"
      variant="plain"
      sub="Small notes, snippets and things learned along the way."
    />
    <div class="bits-feed">
      {
        bits.map((b, i) => (
          <article class="bit reveal" style={`--i:${i + 4}`}>
            <time class="bit-date">{b.date}</time>
            <div class="bit-body">
              <h2>{b.title}</h2>
              <p>{b.body}</p>
              <pre class="code">{b.code}</pre>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</Layout>
