---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site, bits } from "../data/site.js";
---

<Layout title={`Bits | ${site.name}`}>
  <main class="page">
    <PageHeader
      path="BITS"
      cmd="bits --recent"
      title="Bits"
      sub="Small notes, snippets and things learned along the way."
    />
    <div class="grid2" style="margin-top:28px">
      {
        bits.map((b, i) => (
          <article class="tcard reveal" style={`--i:${i + 4}`}>
            <div class="kicker">{b.date}</div>
            <h2>{b.title}</h2>
            <p>{b.body}</p>
            <pre class="code">{b.code}</pre>
          </article>
        ))
      }
    </div>
  </main>
</Layout>
