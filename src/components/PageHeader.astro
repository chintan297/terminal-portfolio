---
const { path, cmd, title, sub, variant = "frame" } = Astro.props; // frame | plain | center
---

<header class:list={["ph", "card", "reveal", variant]}>
  <span class="label l">~/{path}</span>
  <div class="prompt reveal cursor" style="--i:1">$ {cmd}</div>
  <h1 class="reveal" style="--i:2">{title}</h1>
  {
    sub && (
      <p class="sub reveal" style="--i:3">
        {sub}
      </p>
    )
  }
</header>
