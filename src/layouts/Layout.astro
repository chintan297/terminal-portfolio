---
import { ClientRouter } from "astro:transitions";
import "@fontsource/jetbrains-mono/latin-400.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/effects.css";
import "../styles/polish.css";
import "../styles/pixel.css";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";
import Seo from "../components/Seo.astro";
import { getCollection } from "astro:content";
import { site, nav, quotes, series, bits } from "../data/site.js";

const posts = await getCollection("blog");
const projects = await getCollection("projects");
const {
  title = site.title,
  description = site.summary,
  showFooter = true,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";



// Flat index for the `/` search: pages first, then headings found on them.
const index = [
  ...nav.map((n) => ({
    kind: "page",
    title: n.label[0].toUpperCase() + n.label.slice(1),
    detail: "",
    href: n.href,
  })),
  ...projects.map((p) => ({
    kind: "heading",
    title: p.data.title,
    detail: "Projects",
    href: `/projects/${p.id}`,
  })),
  ...quotes.map((q) => ({
    kind: "heading",
    title: q.text.slice(0, 70),
    detail: "Quotes",
    href: "/quotes",
  })),
  ...bits.map((b) => ({
    kind: "heading",
    title: b.title,
    detail: "Bits",
    href: "/bits",
  })),
  ...series.flatMap((s) =>
    s.items.map((t) => ({
      kind: "heading",
      title: t.title,
      detail: "Tutorials",
      href: "/tutorials",
    })),
  ),
  ...posts.map((p) => ({
    kind: "heading",
    title: p.data.title,
    detail: "Blog",
    href: `/blog/${p.id}`,
  })),
];
---

<!doctype html>
<html lang="en" data-theme="mono" data-fx="on">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#000000" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/DepartureMono-Regular.woff2"
      crossorigin
    />
    <Seo title={title} description={description} />
    <script is:inline src="/theme-init.js"></script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <nav id="nav" aria-label="Primary">
        <span class="host">[{site.host}]</span>
        {
          nav.map((n) => (
            <a
              href={n.href}
              aria-current={
                path === n.href ||
                (n.href !== "/" && path.startsWith(n.href + "/"))
                  ? "page"
                  : undefined
              }
            >
              {n.key}:{n.label}
            </a>
          ))
        }
      </nav>
      <button
        class="menu-btn"
        id="menu-btn"
        type="button"
        aria-controls="menu-panel"
        aria-expanded="false"><span class="mb-icon" aria-hidden="true">☰</span> MENU</button
      >
      <span class="crumb" aria-hidden="true">~/{(nav.find((n) => path === n.href || (n.href !== "/" && path.startsWith(n.href + "/"))) ?? nav[0]).file}</span>
      <div class="right">
        <span class="hide-m">"{site.user}"</span>
        <span id="clock" class="clock">--:--</span>
        <span id="date" class="hide-m">--</span>
      </div>
    </header>

    <canvas id="page-wipe" class="page-wipe" aria-hidden="true" transition:persist></canvas>
    <div class="menu-scrim" id="menu-scrim" hidden></div>
    <nav class="menu-panel card" id="menu-panel" aria-label="Pages" hidden>
      <span class="label l">PAGES</span>
      <p class="menu-head"><span>$ select page in ~/*</span><span>{nav.length} files</span></p>
      <ol>
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                aria-current={path === n.href || (n.href !== "/" && path.startsWith(n.href + "/")) ? "page" : undefined}
              >
                <span class="num">{n.key})</span>
                <span class="ttl">{n.label[0].toUpperCase() + n.label.slice(1)}<small>~/{n.file}</small></span>
                <kbd>alt+{n.key}</kbd>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="menu-foot">
        <span>#? <b id="menu-num"></b></span>
        <button id="menu-close" type="button">ESC <b>CLOSE</b></button>
      </div>
    </nav>

    <div class="view" id="main" tabindex="-1" transition:animate="none">
      <slot />
      {showFooter && <Footer />}
    </div>

    <footer class="statusbar" aria-label="Status bar">
      <span class="mode">NORMAL</span>
      <span class="hide-m">~/{path === "/" ? "index" : path.slice(1)} [+]</span>
      <span class="grow hide-m">main</span>
      <button id="theme-btn" type="button" title="Click to cycle themes"
        ><span class="sr-only">Cycle theme: </span>■ <span id="theme-name"
          >MONO</span
        ></button
      >
      <span class="grow"></span>
      <span class="hide-m" id="year"></span>
      <button
        id="fx-btn"
        type="button"
        title="Quality Mode: toggle visual effects"
        aria-pressed="true"
        ><span class="sr-only">Visual effects </span><span aria-hidden="true"
          >✎</span
        ></button
      >
      <button id="search-btn" type="button" title="Search (/)"
        ><span class="sr-only">Open search </span>/</button
      >
      <button
        id="keys-btn"
        type="button"
        title="Single-key shortcuts : and /"
        aria-pressed="true">keys</button
      >
      <span class="hide-m">html</span>
      <span class="mode" id="scrollpct">0%</span>
    </footer>

    <div class="fx-overlay fx-scan" aria-hidden="true"></div>
    <div class="fx-overlay fx-vig" aria-hidden="true"></div>
    <div class="noise-overlay" aria-hidden="true"></div>
    <Cursor />

    <div
      id="cmd"
      data-index={JSON.stringify(index)}
      data-nav={JSON.stringify(nav)}
      data-email={site.email}
      transition:persist
    >
      <ul id="plist" role="listbox" aria-label="Results"></ul>
      <div class="row">
        <span id="pfx" aria-hidden="true">/</span>
        <input
          id="pin"
          role="combobox"
          aria-expanded="false"
          aria-controls="plist"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search or run a command"
        />
        <span id="cmd-status" class="sr-only" aria-live="polite"></span>
        <button id="cmd-close" class="cmd-close" type="button" aria-label="Close search"><span aria-hidden="true">✕</span></button>
      </div>
    </div>
    <button id="to-top" class="to-top" type="button"
      ><span class="sr-only">Back to top </span><span aria-hidden="true">↑</span
      ></button
    >
    <p id="live" class="sr-only" role="status" aria-live="polite"></p>
    <div id="splash" class="done" aria-hidden="true" transition:persist></div>

    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
